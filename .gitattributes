# Keep internal planning and agent material out of the source archive
# (`git archive`, GPLv3 section 6(d) corresponding source). Planning markdown is not
# "source code needed to generate, install, or run the object code" (GPLv3 section 1).
.planning/ export-ignore
.claude/ export-ignore
CLAUDE.md export-ignore
.gitattributes export-ignore

# D-13: the Grifter binary is SERVED from the site but is not redistributed with it.
# `git archive HEAD` publishes this tree at an unauthenticated URL, which is a different
# permission from displaying a face on your own site, and the one most foundry licences
# withhold. static/fonts/README.md stands in the archive in its place, naming the family
# and where to obtain it. src/lib/ui/font-assets.spec.ts asserts this line exists.
static/fonts/GRIFTER-Bold.woff2 export-ignore

# LF in the index everywhere; this is a Windows checkout with CRLF working copies.
* text=auto eol=lf

# Vendored BOTOR sources are byte-identity artefacts: src/lib/fidelity/upstream-manifest.json
# hashes their exact bytes and src/lib/fidelity/vendored-diff.spec.ts asserts them. Opt them out of
# end-of-line normalisation so no future rule can rewrite a byte the manifest pins.
src/vendor/** -text
AGENTS.md export-ignore
