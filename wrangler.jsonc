{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hangar",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "observability": { "enabled": true },
}
