{
  "name": "hangar",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/gen-og.mjs && vite build && node scripts/postbuild.mjs",
    "preview": "npm run build && wrangler dev --port 4173 --ip 127.0.0.1",
    "deploy": "node scripts/deploy.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "licenses": "node scripts/gen-licenses.mjs",
    "test:unit": "vitest",
    "test:quick": "vitest run --project server",
    "test:sweep": "vitest run --project sweep",
    "test:e2e": "playwright test",
    "test": "npm run test:unit -- --run && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24",
    "@types/w3c-web-serial": "^1.0.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@intechstudio/grid-protocol": "1.20260825.1135",
    "wasmoon": "1.16.0"
  }
}
